# ===== GitHub OAuth App（真名代理）=====
# Settings -> Developer settings -> OAuth Apps，需勾选 Enable Device Flow
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# public_repo（仅公开库，推荐）或 repo（含私有库）
GITHUB_SCOPE=public_repo

# ===== 飞书自建应用（机器人 + 长连接）=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 未绑定检视人时，提示哪个管理员（GitHub login，可留空）
ADMIN_GITHUB_LOGIN=

# ===== LLM（OpenAI 兼容端点，可切换）=====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# 单次检视调用的读超时（秒）。推理模型处理整段 diff 较慢，建议 600
LLM_TIMEOUT=600
# 送给模型的 diff 最大字符数，超出截断（越大越慢；agent 可用工具读取完整文件）
MAX_DIFF_CHARS=120000

# ===== Agent 层（所有模型调用的唯一入口）=====
# 选用后端，内置：pydantic_ai / echo
AGENT_BACKEND=pydantic_ai
# 后端不可用时的降级链（逗号分隔，按序下探）
AGENT_FALLBACK=echo
# 是否允许 agent 调用工具自主检索（PR 文件 / 仓库文件 / 代码搜索 / PR 提交）
AGENT_TOOLS_ENABLED=true
# 工具调用轮数上限，防止多轮检索跑飞
AGENT_MAX_TURNS=8
# 可选的 MCP server（JSON 数组），留空则不挂载。示例：
#   [{"name":"git","command":"npx","args":["-y","@modelcontextprotocol/server-git","--repository","/path/to/repo"]}]
#   [{"name":"remote","url":"http://127.0.0.1:8000/mcp","headers":{"Authorization":"Bearer xxx"}}]
AGENT_MCP_SERVERS=

# ===== 本地存储与运行参数 =====
DB_PATH=./data/review_agent.db
POLL_INTERVAL=60
# 代理做了 TLS 中间人时的自签名根证书（需与公共根证书合并成 bundle）；不用代理可留空
# 合并命令：python -c "import certifi,pathlib; pathlib.Path('ca-bundle.pem').write_bytes(pathlib.Path(certifi.where()).read_bytes()+pathlib.Path('ProxyCA.crt').read_bytes())"
CA_BUNDLE=
# 用于加密 gho_ token，生成命令：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
